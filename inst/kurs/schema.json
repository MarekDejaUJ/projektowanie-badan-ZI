{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Konfiguracja części ilościowej kursu ZI",
  "type": "object",
  "required": ["rocznik", "tytul", "kierunek", "kod", "zakres_sylabusa", "cwiczenia", "wyklady", "minuty_spotkania", "egzamin", "projekt", "timezone", "wersja_pakietu", "wersja_generatora", "wersja_rubryk", "termin_projektu", "termin_spozniony", "termin_poprawek", "zasada_terminow_zadan", "terminy_zadan", "daty_zajec", "wagi", "progi_ocen", "spoznienia", "poprawki", "maksymalna_ocena_spozniona", "zaokraglenie", "laczenie_ocen", "adapter", "logowanie"],
  "properties": {
    "rocznik": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "tytul": {"$ref": "#/$defs/tekst"},
    "kierunek": {"$ref": "#/$defs/tekst"},
    "kod": {"$ref": "#/$defs/tekst"},
    "zakres_sylabusa": {"const": [9, 10, 11, 12, 13, 14, 15]},
    "cwiczenia": {"const": 10},
    "wyklady": {"const": 5},
    "minuty_spotkania": {"const": 90},
    "egzamin": {"const": false},
    "projekt": {"$ref": "#/$defs/tekst"},
    "timezone": {"$ref": "#/$defs/tekst"},
    "wersja_pakietu": {"$ref": "#/$defs/wersja"},
    "wersja_generatora": {"$ref": "#/$defs/wersja"},
    "wersja_rubryk": {"$ref": "#/$defs/wersja"},
    "termin_projektu": {"$ref": "#/$defs/czas"},
    "termin_spozniony": {"$ref": "#/$defs/czas"},
    "termin_poprawek": {"$ref": "#/$defs/czas"},
    "koniec_zajec": {"$ref": "#/$defs/czas"},
    "ostatni_przedzial_zajec": {"$ref": "#/$defs/tekst"},
    "zasada_terminow_zadan": {"enum": ["nastepne_cwiczenie", "daty"]},
    "terminy_zadan": {"type": ["object", "null"], "propertyNames": {"pattern": "^Z(0[1-9]|10)$"}, "maxProperties": 10, "additionalProperties": {"$ref": "#/$defs/czas"}},
    "daty_zajec": {"type": ["object", "null"], "propertyNames": {"pattern": "^(C(0[1-9]|10)|W0[1-5])$"}, "maxProperties": 15, "additionalProperties": {"type": "string", "format": "date-time"}},
    "wagi": {"type": "object", "required": ["zadania", "projekt"], "additionalProperties": false, "properties": {"zadania": {"type": "number", "minimum": 0, "maximum": 1}, "projekt": {"type": "number", "minimum": 0, "maximum": 1}}},
    "progi_ocen": {"type": "object", "required": ["3.0", "3.5", "4.0", "4.5", "5.0"], "additionalProperties": {"type": "number", "minimum": 0, "maximum": 100}, "maxProperties": 5},
    "spoznienia": {"$ref": "#/$defs/tekst"},
    "potracenie_za_spoznienie": {"$ref": "#/$defs/tekst"},
    "maksymalna_ocena_spozniona": {"enum": [3, 3.5, 4, 4.5, 5]},
    "poprawki": {"$ref": "#/$defs/tekst"},
    "zaokraglenie": {"$ref": "#/$defs/tekst"},
    "laczenie_ocen": {"$ref": "#/$defs/tekst"},
    "adapter": {"const": "github"},
    "organizacja": {"type": ["string", "null"]},
    "wlasciciel_repozytoriow": {"$ref": "#/$defs/tekst"},
    "oauth_client_id": {"type": ["string", "null"]},
    "logowanie": {"enum": ["auto", "gh", "device"]},
    "zasady_oceny": {"$ref": "#/$defs/tekst"},
    "zasady_si": {"enum": ["pomoc_w_kodzie", "pomoc_w_redakcji", "bez_si"]},
    "opis_si": {"$ref": "#/$defs/tekst"},
    "zrodlo_zasad_si": {"type": "string", "format": "uri"}
  },
  "additionalProperties": false,
  "$defs": {
    "tekst": {"type": "string", "minLength": 1},
    "wersja": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"},
    "czas": {"type": ["string", "null"], "format": "date-time"}
  }
}
